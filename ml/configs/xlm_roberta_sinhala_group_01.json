{
  "experiment_id": "XLMR-SINHALA-GROUP-01",
  "model_name": "FacebookAI/xlm-roberta-base",
  "training_data": "English, Sinhala, and Singlish tracks (english, sinhala, singlish)",
  "task": "77-class intent classification (BANKING77)",
  "max_length": 128,
  "epochs": 5,
  "learning_rate": 3e-05,
  "per_device_train_batch_size": 16,
  "per_device_eval_batch_size": 32,
  "gradient_accumulation_steps": 2,
  "effective_batch_size": 32,
  "weight_decay": 0.01,
  "warmup_ratio": 0.1,
  "lr_scheduler_type": "linear",
  "max_grad_norm": 1.0,
  "eval_strategy": "epoch",
  "save_strategy": "epoch",
  "load_best_model_at_end": true,
  "metric_for_best_model": "macro_f1",
  "greater_is_better": true,
  "save_total_limit": 2,
  "seed": 42,
  "data_seed": 42,
  "purpose": "Train XLM-RoBERTa as a specialized Sri Lankan and English expert model."
}
