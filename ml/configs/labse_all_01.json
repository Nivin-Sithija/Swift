  "greater_is_better": true,
  "save_total_limit": 2,
  "seed": 42,
  "data_seed": 42,
  "purpose": "Fine-tune Google's Language-Agnostic BERT Sentence Embedding (LaBSE) model across all 5 language tracks to evaluate 501k-vocabulary cross-lingual alignment against XLM-RoBERTa."
