<View>
  <Header value="Review this support message"/>

  <View style="background: #f7f7f7; padding: 1em; border-radius: 5px; margin-bottom: 1em">
    <Text name="category" value="Category: $category"/>
  </View>

  <Text name="my_text" value="$text"/>

  <Header value="Sentiment" size="4"/>
  <Choices name="sentiment" toName="my_text" choice="single" showInline="true" required="true">
    <Choice value="Neutral"/>
    <Choice value="Negative"/>
  </Choices>

  <Header value="Priority" size="4"/>
  <Choices name="priority" toName="my_text" choice="single" showInline="true" required="true">
    <Choice value="Low"/>
    <Choice value="Medium"/>
    <Choice value="High"/>
  </Choices>
</View>
