SWIFT_ENVIRONMENT=development
# Standard postgresql:// Supabase URLs are normalized to use asyncpg automatically.
SWIFT_DATABASE_URL=postgresql://swift:swift@postgres:5432/swift
SWIFT_REDIS_URL=redis://redis:6379/0
SWIFT_SECRET_KEY=replace-with-at-least-32-random-characters
SWIFT_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
SWIFT_STORAGE_ROOT=/data/attachments
SWIFT_MAX_UPLOAD_BYTES=10485760
SWIFT_USE_INLINE_PROCESSING=true
# Required to create support-agent accounts through the registration form.
SWIFT_AGENT_REGISTRATION_CODE=replace-with-a-long-random-code
